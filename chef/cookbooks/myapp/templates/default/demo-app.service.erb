# =============================================================================
# templates/default/demo-app.service.erb — systemd unit file
# Managed by Chef — do not edit manually
# =============================================================================
[Unit]
Description=<%= @app_name %> — CI/CD Demo Application
Documentation=https://github.com/cicd-demo/demo-app
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=<%= @user %>
Group=<%= @group %>
WorkingDirectory=<%= @install_dir %>

# Load environment variables
EnvironmentFile=<%= @install_dir %>/app.env

ExecStart=/usr/bin/java \
    ${JAVA_OPTS} \
    -jar <%= @install_dir %>/<%= @app_name %>.jar \
    --server.port=${APP_PORT}

ExecStop=/bin/kill -SIGTERM $MAINPID

# Logging
StandardOutput=append:<%= @log_dir %>/stdout.log
StandardError=append:<%= @log_dir %>/stderr.log

# Restart policy
Restart=<%= @restart %>
RestartSec=10s
StartLimitInterval=120s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
TimeoutStartSec=120
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
